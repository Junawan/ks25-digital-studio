rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Bukti pembayaran langganan
    match /subscription-payments/{paymentId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Gambar produk
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Logo perusahaan
    match /companies/{companyId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Selfie bukti absensi karyawan.
    match /attendance/{companyId}/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // Media undangan milik akun KS25. Tautan undangan publik membaca URL media.
    match /invitation-assets/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 15 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
          || request.resource.contentType.matches('audio/.*'));
    }

    // Semua file lainnya
    match /{allPaths=**} {
      allow read: if false;
      allow write: if false;
    }

  }
}
